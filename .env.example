# Clave de API de OpenAI (platform.openai.com). Requerida por lib/clienteIA.ts.
# PROVISIONAL hasta volver a Claude: entonces será ANTHROPIC_API_KEY.
# Nunca se expone al cliente: solo se lee del lado del servidor.
OPENAI_API_KEY=

# Opcionales. Los valores por defecto están en el código.
# Límite de caracteres de la nota (por defecto 40000).
LONGITUD_MAXIMA_NOTA=
# Límite de peticiones por IP y ventana (por defecto 5 análisis / 20 reanálisis cada 10 min).
LIMITE_ANALISIS_POR_VENTANA=
LIMITE_REANALISIS_POR_VENTANA=
LIMITE_VENTANA_MS=
# Temperatura del modelo (por defecto 0.5; las evals la fijan a 0.2).
IA_TEMPERATURA=
# La pasada crítica (lib/pasadaCritica.ts) va siempre incluida en el análisis completo.

# Cuentas (fase 13B): Firebase Auth. Valores de Consola Firebase → Configuración
# del proyecto → Tus apps (web). Son públicos por diseño; la seguridad la dan las
# reglas de Firestore y el servidor. Sin ellos, la app funciona sin cuentas.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Casos en la nube cifrados (fase 13). Dejar apagado hasta desplegar reglas y ranuras.
NEXT_PUBLIC_ACIA_NUBE=

# Firebase Admin SDK (solo servidor, fase 13). Preferible: Application Default Credentials
# (gcloud auth application-default login, o GOOGLE_APPLICATION_CREDENTIALS con un archivo
# FUERA del repositorio). Solo si no es viable, estas variables privadas (nunca NEXT_PUBLIC_):
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Solo desarrollo: con "1" las rutas de IA no exigen sesión (lo fijan dev:evals y dev:maqueta).
# En producción se ignora. Déjalo vacío.
ACIA_SIN_SESION_IA=
