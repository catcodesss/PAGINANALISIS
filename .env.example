# Clave de API de OpenAI (platform.openai.com). Requerida por lib/clienteIA.ts.
# PROVISIONAL hasta volver a Claude: entonces será ANTHROPIC_API_KEY.
# Nunca se expone al cliente: solo se lee del lado del servidor.
OPENAI_API_KEY=

# Opcionales. Los valores por defecto están en el código.
# Límite de caracteres de la nota (por defecto 40000).
LONGITUD_MAXIMA_NOTA=
# Límite de peticiones por IP y ventana (por defecto 5 análisis / 20 reanálisis cada 10 min).
LIMITE_ANALISIS_POR_VENTANA=
LIMITE_REANALISIS_POR_VENTANA=
LIMITE_VENTANA_MS=
# Temperatura del modelo (por defecto 0.5; las evals la fijan a 0.2).
IA_TEMPERATURA=
# La pasada crítica (lib/pasadaCritica.ts) va siempre incluida en el análisis completo.
